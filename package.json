{
  "name": "atlas-karst",
  "version": "0.18.0-q.0",
  "atlasVersion": "0.18q",
  "private": true,
  "description": "Atlas cartographique autonome à rendu Canvas symbolique et ASCII",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:check": "node tools/build.mjs --check",
    "start": "node tools/serve.mjs",
    "test": "npm run test:static",
    "test:static": "npm run build:check && node tools/audit-html.mjs",
    "test:browser": "node tools/browser-check.mjs",
    "test:all": "npm run test:static && npm run test:browser",
    "benchmark:render": "node tools/benchmark-render.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
